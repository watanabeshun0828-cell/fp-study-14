{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "day": {
      "type": "integer",
      "minimum": 1,
      "maximum": 14
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "subtitle": {
      "type": "string",
      "minLength": 1
    },
    "group": {
      "type": "string",
      "minLength": 1
    },
    "minutes": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "objectives": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "sources": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": "string",
            "format": "uri"
          }
        },
        "required": [
          "title",
          "url"
        ],
        "additionalProperties": false
      }
    },
    "cases": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "route": {
            "type": "string",
            "minLength": 1
          },
          "intro": {
            "type": "string",
            "minLength": 1
          },
          "rows": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "label": {
                  "type": "string",
                  "minLength": 1
                },
                "value": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "label",
                "value"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "id",
          "title",
          "route",
          "intro",
          "rows"
        ],
        "additionalProperties": false
      }
    },
    "sections": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "paragraphs": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "keyPoint": {
            "type": "string",
            "minLength": 1
          },
          "exercise": {
            "type": "object",
            "properties": {
              "title": {
                "type": "string",
                "minLength": 1
              },
              "prompt": {
                "type": "string",
                "minLength": 1
              },
              "sample": {
                "type": "string",
                "minLength": 1
              },
              "checklist": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "required": [
              "title",
              "prompt",
              "sample",
              "checklist"
            ],
            "additionalProperties": false
          },
          "diagram": {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "nested",
                  "flow"
                ]
              },
              "title": {
                "type": "string",
                "minLength": 1
              },
              "items": {
                "minItems": 2,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "label": {
                      "type": "string",
                      "minLength": 1
                    },
                    "detail": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [
                    "label",
                    "detail"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "title",
              "items"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "id",
          "title",
          "paragraphs",
          "keyPoint"
        ],
        "additionalProperties": false
      }
    },
    "questions": {
      "minItems": 1,
      "type": "array",
      "items": {
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "category": {
                "type": "string",
                "minLength": 1
              },
              "sectionId": {
                "type": "string",
                "minLength": 1
              },
              "prompt": {
                "type": "string",
                "minLength": 1
              },
              "explanation": {
                "type": "string",
                "minLength": 1
              },
              "caseId": {
                "type": "string",
                "minLength": 1
              },
              "choices": {
                "minItems": 2,
                "maxItems": 4,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "correctIndex": {
                "type": "integer",
                "minimum": 0,
                "maximum": 3
              }
            },
            "required": [
              "id",
              "category",
              "sectionId",
              "prompt",
              "explanation",
              "choices",
              "correctIndex"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "category": {
                "type": "string",
                "minLength": 1
              },
              "sectionId": {
                "type": "string",
                "minLength": 1
              },
              "prompt": {
                "type": "string",
                "minLength": 1
              },
              "explanation": {
                "type": "string",
                "minLength": 1
              },
              "caseId": {
                "type": "string",
                "minLength": 1
              },
              "format": {
                "type": "string",
                "const": "numeric"
              },
              "solution": {
                "type": "number"
              },
              "unit": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "id",
              "category",
              "sectionId",
              "prompt",
              "explanation",
              "format",
              "solution",
              "unit"
            ],
            "additionalProperties": false
          }
        ]
      }
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "day",
    "title",
    "subtitle",
    "minutes",
    "objectives",
    "sections",
    "questions"
  ],
  "additionalProperties": false
}
